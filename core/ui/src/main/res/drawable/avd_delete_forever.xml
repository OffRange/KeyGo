<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:name="vector"
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <path
                android:name="body"
                android:fillColor="#000000"
                android:pathData="M 6 19 C 6 20.1 6.9 21 8 21 L 16 21 C 17.1 21 18 20.1 18 19 L 18 7 L 6 7 L 6 19 Z M 8.46 11.88 L 9.87 10.47 L 12 12.59 L 14.12 10.47 L 15.53 11.88 L 13.41 14 L 15.53 16.12 L 14.12 17.53 L 12 15.41 L 9.88 17.53 L 8.47 16.12 L 10.59 14 L 8.46 11.88 Z" />
            <group
                android:name="lid_group"
                android:pivotX="12"
                android:pivotY="3">
                <path
                    android:name="lid"
                    android:fillColor="#000000"
                    android:pathData="M 15.5 4 L 14.5 3 L 9.5 3 L 8.5 4 L 5 4 L 5 6 L 19 6 L 19 4 Z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="lid_group">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="60"
                    android:interpolator="@android:anim/linear_interpolator"
                    android:propertyName="rotation"
                    android:valueFrom="0"
                    android:valueTo="15"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="80"
                    android:interpolator="@android:anim/linear_interpolator"
                    android:propertyName="rotation"
                    android:startOffset="60"
                    android:valueFrom="15"
                    android:valueTo="-10"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="80"
                    android:interpolator="@android:anim/linear_interpolator"
                    android:propertyName="rotation"
                    android:startOffset="140"
                    android:valueFrom="-10"
                    android:valueTo="5"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="80"
                    android:interpolator="@android:anim/linear_interpolator"
                    android:propertyName="rotation"
                    android:startOffset="220"
                    android:valueFrom="5"
                    android:valueTo="0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
